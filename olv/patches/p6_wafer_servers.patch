diff --git a/src/open_llm_vtuber/tts/wafer_http_tts.py b/src/open_llm_vtuber/tts/wafer_http_tts.py
new file mode 100644
index 0000000..0e1278c
--- /dev/null
+++ b/src/open_llm_vtuber/tts/wafer_http_tts.py
@@ -0,0 +1,41 @@
+"""wafer TTS adapter: CosyVoice served by wafer's cosyvoice_server (:9880).
+
+OLV's TTS interface is file-based, so each call writes one wav into OLV's
+`cache/` directory and returns its path; OLV plays it and deletes it.
+The server does clause splitting internally, so long sentences still come
+back in one file (latency is handled by OLV's sentence divider).
+"""
+
+import httpx
+from loguru import logger
+
+from .tts_interface import TTSInterface
+
+
+class TTSEngine(TTSInterface):
+    def __init__(
+        self,
+        base_url: str = "http://127.0.0.1:9880",
+        timeout: float = 300.0,
+        file_extension: str = "wav",
+    ) -> None:
+        self._url = base_url.rstrip("/")
+        self._timeout = timeout
+        self.file_extension = file_extension
+        logger.info(f"wafer TTS: cosyvoice_server at {self._url}")
+
+    def generate_audio(self, text, file_name_no_ext=None):
+        file_name = self.generate_cache_file_name(
+            file_name_no_ext, self.file_extension)
+        try:
+            resp = httpx.post(f"{self._url}/synthesize",
+                              json={"text": text}, timeout=self._timeout)
+            resp.raise_for_status()
+            if not resp.content.startswith(b"RIFF"):
+                raise RuntimeError("cosyvoice_server returned non-wav payload")
+            with open(file_name, "wb") as handle:
+                handle.write(resp.content)
+            return file_name
+        except Exception as exc:  # noqa: BLE001 -- degrade to silence
+            logger.error(f"wafer TTS failed: {exc}")
+            return ""
