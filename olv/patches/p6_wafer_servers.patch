diff --git a/src/open_llm_vtuber/asr/wafer_llama_asr.py b/src/open_llm_vtuber/asr/wafer_llama_asr.py
new file mode 100644
index 0000000..20329f9
--- /dev/null
+++ b/src/open_llm_vtuber/asr/wafer_llama_asr.py
@@ -0,0 +1,115 @@
+"""wafer ASR adapter: Qwen3-ASR served by llama-server (:8001).
+
+The model is a GGUF + audio projection (mmproj) loaded by llama-server; this
+class only wraps the OpenAI-style /v1/chat/completions call. Kept out of the
+ASR factory's built-in list so the upstream tree stays replaceable (see
+olv/patches/p6_wafer_servers.patch).
+"""
+
+import base64
+import io
+import re
+import wave
+
+import httpx
+import numpy as np
+from loguru import logger
+
+from .asr_interface import ASRInterface
+
+_PREFIX_LANG_RE = re.compile(
+    r"^\s*language\s*[:=]?\s*([A-Za-z\u4e00-\u9fff\-_ ]{2,24}?)\s*"
+    r"(?:<\s*/?\s*asr_text\s*/?\s*>|\|\s*asr_text\s*\|)",
+    re.I,
+)
+_LANG_TAG_RE = re.compile(r"^\s*<\|\s*([A-Za-z\-_]+)\s*\|>\s*")
+_ASR_TEXT_TAG_RE = re.compile(r"<\s*/?\s*asr_text\s*/?>", re.I)
+_ANY_TAG_RE = re.compile(r"<\|[^|>]{0,24}\|>")
+
+
+def clean_asr_text(raw: str) -> str:
+    """Strip Qwen3-ASR's language prefixes / special tokens."""
+    s = str(raw or "").strip()
+    match = _PREFIX_LANG_RE.match(s)
+    if match:
+        s = s[match.end():]
+    else:
+        s = _LANG_TAG_RE.sub("", s, count=1)
+    s = _ASR_TEXT_TAG_RE.sub("", s)
+    s = _ANY_TAG_RE.sub("", s)
+    return s.strip().strip("\"'“”‘’").strip()
+
+
+def pcm_to_wav_b64(audio: np.ndarray, sample_rate: int = 16000) -> str:
+    """float32 [-1,1] mono -> base64 wav (16-bit PCM)."""
+    pcm = (np.clip(audio, -1.0, 1.0) * 32767.0).astype(np.int16)
+    buf = io.BytesIO()
+    with wave.open(buf, "wb") as handle:
+        handle.setnchannels(1)
+        handle.setsampwidth(2)
+        handle.setframerate(sample_rate)
+        handle.writeframes(pcm.tobytes())
+    return base64.b64encode(buf.getvalue()).decode("ascii")
+
+
+class VoiceRecognition(ASRInterface):
+    def __init__(
+        self,
+        base_url: str = "http://127.0.0.1:8001",
+        model: str = "qwen3-asr",
+        hotwords=None,
+        timeout: float = 60.0,
+        dump: bool = False,
+    ) -> None:
+        self._url = base_url.rstrip("/")
+        self._model = model
+        self._hotwords = list(hotwords or [])
+        self._timeout = timeout
+        self._dump = dump
+        logger.info(f"wafer ASR: llama-server at {self._url} (model={model})")
+
+    def transcribe_np(self, audio: np.ndarray) -> str:
+        audio = np.asarray(audio, dtype=np.float32).reshape(-1)
+        peak = float(np.max(np.abs(audio))) if audio.size else 0.0
+        rms = float(np.sqrt(np.mean(audio ** 2))) if audio.size else 0.0
+        # Some clients send int16-scaled values; llama-server expects [-1, 1].
+        if peak > 1.5:
+            audio = audio / 32768.0
+            peak = peak / 32768.0
+            rms = rms / 32768.0
+        logger.info(f"wafer ASR input: samples={audio.size} "
+                    f"({audio.size / self.SAMPLE_RATE:.1f}s) "
+                    f"peak={peak:.3f} rms={rms:.4f}")
+        if self._dump:
+            self.nparray_to_audio_file(audio, self.SAMPLE_RATE,
+                                       "cache/wafer_asr_last.wav")
+        content = [{
+            "type": "input_audio",
+            "input_audio": {
+                "data": f"data:audio/wav;base64,"
+                        f"{pcm_to_wav_b64(audio, self.SAMPLE_RATE)}",
+                "format": "wav",
+            },
+        }]
+        if self._hotwords:
+            content.append({"type": "text",
+                            "text": "Hotwords: " + ", ".join(self._hotwords[:24])})
+        # Long utterances need more output budget (256 truncates ~30s speech).
+        seconds = audio.size / self.SAMPLE_RATE
+        max_tokens = max(256, min(2048, int(seconds * 20)))
+        payload = {
+            "model": self._model,
+            "messages": [{"role": "user", "content": content}],
+            "max_tokens": max_tokens,
+            "temperature": 0.0,
+            "stream": False,
+        }
+        try:
+            resp = httpx.post(f"{self._url}/v1/chat/completions",
+                              json=payload, timeout=self._timeout)
+            resp.raise_for_status()
+            raw = resp.json()["choices"][0]["message"]["content"]
+        except Exception as exc:  # noqa: BLE001 -- degrade: caller handles ""
+            logger.error(f"wafer ASR request failed: {exc}")
+            return ""
+        return clean_asr_text(raw)
