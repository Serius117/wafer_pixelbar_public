+class _WaferAgentAdapter(AgentInterface):
+    """Thin adapter: wraps WaferAgent into OLV's AgentInterface.
+
+    Converts (display_text, tts_text) tuples from WaferAgent.chat() into
+    SentenceOutput objects that OLV's conversation handler expects.
+    """
+
+    def __init__(self, wafer_agent, live2d_model=None):
+        super().__init__()
+        self._wafer = wafer_agent
+        self._live2d = live2d_model
+
+    async def chat(self, input_data):
+        from .agents.basic_memory_agent import sentence_divider, display_processor, tts_filter
+        from .output_types import SentenceOutput, DisplayText, Actions
+        from .input_types import BatchInput, TextSource
+        from ..config_manager import TTSPreprocessorConfig
+        from ..chat_history_manager import store_message
+
+        # Extract user text from BatchInput
+        text = ""
+        if hasattr(input_data, "texts") and input_data.texts:
+            for td in input_data.texts:
+                if td.source == TextSource.INPUT:
+                    text = td.content
+                    break
+        if not text:
+            return
+
+        # Store user message in OLV history (for the frontend chat log)
+        if hasattr(input_data, "metadata"):
+            skip = (input_data.metadata or {}).get("skip_history", False)
+            if not skip and hasattr(self, "_history_uid") and self._history_uid:
+                try:
+                    from ..chat_history_manager import store_message as sm
+                    sm(conf_uid=self._conf_uid, history_uid=self._history_uid,
+                       role="human", content=text, name="User")
+                except Exception:
+                    pass
+
+        # Delegate to WaferAgent (yields (display, tts) tuples)
+        async for display, tts_text in self._wafer.chat(text):
+            dt = DisplayText(text=display, name="AI", avatar=None)
+            actions = Actions()
+            yield SentenceOutput(
+                display_text=dt, tts_text=tts_text, actions=actions)
+
+    def handle_interrupt(self, heard_response: str) -> None:
+        self._wafer.handle_interrupt(heard_response)
+
+    def set_memory_from_history(self, conf_uid: str, history_uid: str) -> None:
+        self._conf_uid = conf_uid
+        self._history_uid = history_uid
+        self._wafer.set_memory_from_history(conf_uid, history_uid)
