+    async def switch_model(self, model_name: str) -> list:
+        """Switch the Live2D model for all live contexts; notify each client."""
+        contexts = [self.default_context_cache]
+        contexts.extend(ctx for ctx in self.client_contexts.values()
+                        if ctx is not self.default_context_cache)
+        changed = []
+        for context in contexts:
+            try:
+                context.init_live2d(model_name)
+                actual = getattr(context.live2d_model, "live2d_model_name", "")
+                if actual == model_name:
+                    changed.append(context)
+            except Exception as exc:  # noqa: BLE001
+                logger.warning(f"Live2D model switch failed: {exc}")
+        for context in changed:
+            send = getattr(context, "send_text", None)
+            if send is None:
+                continue
+            try:
+                await send(json.dumps({
+                    "type": "set-model-and-conf",
+                    "model_info": context.live2d_model.model_info,
+                    "conf_name": context.character_config.conf_name,
+                    "conf_uid": context.character_config.conf_uid,
+                }))
+            except Exception as exc:  # noqa: BLE001
+                logger.warning(f"Live2D model notify failed: {exc}")
+        return changed
+
+    async def _handle_model_switch(
+        self, websocket: WebSocket, client_uid: str, data: dict
+    ):
+        """WS variant of switch_model (kept for external clients)."""
+        model_name = str(data.get("model_name") or "").strip()
+        if not model_name:
+            return
+        changed = await self.switch_model(model_name)
+        if not changed:
+            await websocket.send_text(json.dumps({
+                "type": "error",
+                "message": f"Unknown Live2D model: {model_name}",
+            }))
+
