+    def _schedule_announce(self, client_uid: str, text: str) -> None:
+        """Enqueue a proactive announcement without blocking the hub callback."""
+        if client_uid not in self.client_connections:
+            return
+        task = asyncio.create_task(self._announce_result(client_uid, text))
+        self.announce_tasks.add(task)
+        task.add_done_callback(self.announce_tasks.discard)
+
+    async def _announce_result(self, client_uid: str, text: str) -> None:
+        """Wait for any active turn, then speak the result through OLV TTS."""
+        lock = self.announce_locks.setdefault(client_uid, asyncio.Lock())
+        async with lock:
+            while True:
+                current = self.current_conversation_tasks.get(client_uid)
+                if current and not current.done():
+                    await current
+                    continue
+                break
+            websocket = self.client_connections.get(client_uid)
+            if websocket is None:
+                return
+            await self._handle_conversation_trigger(
+                websocket, client_uid,
+                {"type": "ai-speak-signal", "announcement": text})
+            current = self.current_conversation_tasks.get(client_uid)
+            if current:
+                await current
