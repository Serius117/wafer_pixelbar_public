# wafer-pixel environment variables (copy to .env and fill in)
# All values are OPTIONAL -- the system reads cloud LLM keys from the
# local opencode config at runtime (never committed to this repo).

# Cloud LLM (dev-machine testing / game-mode chat tier, v1.2)
# Priority: env > opencode config
#WAFER_LLM_API_KEY=
#WAFER_LLM_BASE_URL=
#WAFER_LLM_MODEL=deepseek-v4.1-flash

# Not needed for local-only operation (all engines on localhost):
#   ASR  : llama-server :8001
#   LLM  : llama-server :8080
# TTS  : CosyVoice    :9880

# Optional online TTS: MiniMax T2A v2 (TASK.PROVIDER.02)
# Put endpoint/model/voice in config/providers.local.yaml (gitignored);
# only the keys belong here.
#MINIMAX_API_KEY=
#MINIMAX_GROUP_ID=
#MINIMAX_BASE_URL=https://api.minimax.cn
#MINIMAX_MODEL=speech-2.8-hd
#MINIMAX_VOICE_ID=Chinese_crisp_podcaster_nv1

# Optional online TTS: Aliyun Bailian CosyVoice v3.5-flash (D57)
# Create the voice once, then set tts.provider: aliyun_cosyvoice in
# config/inference.yaml. Never commit the real key.
#DASHSCOPE_API_KEY=
#DASHSCOPE_WORKSPACE_ID=
#DASHSCOPE_VOICE_ID=
